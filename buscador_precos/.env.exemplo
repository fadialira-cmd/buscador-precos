# Copie este arquivo para ".env" e preencha só o que tiver. Nunca compartilhe o .env.

# Mercado Livre Developers (developers.mercadolivre.com.br) — pode ser exigido pela API de busca
ML_ACCESS_TOKEN=

# Shopee Afiliados → Open API (painel de afiliados)
SHOPEE_APP_ID=
SHOPEE_SECRET=

# SerpApi (serpapi.com) — para Google Shopping
SERPAPI_KEY=

# Amazon Associados — só depois da liberação da API
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# Alertas de preço-alvo no Telegram (mesmo bot do monitor de cupons)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
